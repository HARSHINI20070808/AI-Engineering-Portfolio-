//Product Sales and Revenue         
Analysis Using NumPy 📊

import numpy as np

# Product details
price = np.array([1000, 3000, 800, 2000])
quan = np.array([1, 3, 5, 6])

print("Product Price:", price)
print("Quantity:", quan)

# Revenue calculation
revenue = price * quan
print("Revenue:", revenue)

total_rev = np.sum(revenue)
print("Total Revenue:", total_rev)

# Maximum and minimum price
print("Maximum Price:", price.max())
print("Minimum Price:", price.min())

# Highest revenue
print("Maximum Revenue:", revenue.max())
print("Index of Maximum Revenue:", revenue.argmax())

# Average price
avg = np.mean(price)
print("Average Price:", avg)

# Prices above average
result = price > avg
print("Comparison of Average:", result)
print("Prices Above Average:", price[result])

# Revenue filtering
res = revenue > 5000
print("Comparison of Revenue:", res)
print("Revenue Greater Than 5000:", revenue[res])

# Mathematical operations
print("Square Root:", np.sqrt(price))
print("Logarithm:", np.log(price))
print("Floor:", np.floor(price / 200))
print("Ceil:", np.ceil(price / 200))
print("Round:", np.round(price / 200))

# Standard deviation
print("Standard Deviation:", np.std(price))
