//Product Sales and Revenue         
Analysis Using NumPy 📊


import numpy as np
price=np.array([1000,3000,800,2000])
quan=np.array([1,3,5,6])
print("Product price:",price)
print("Quantity:",quan)
revenue=price*quan
print("Revenue:",revenue)
total_rev=np.sum(price*quan)
print("Total Revenue:",total_rev)
print("Maximum price:",price.max())
print("Minimum price:",price.min())
print("Total Revenue index :",revenue.argmax())
avg=np.mean(price)
print("Average:",avg)
result=price>avg
print("Comparison of average :",result)
print("prices are above:",price[result]) 
res=revenue>500
print("Comparison of revenue:",res)
print("Revenue greater than 50000:",revenue[res])
print("Square root of prices:",np.sqrt(price))
print("Log of prices:",np.log(price))
print("Floor of prices:",np.floor(price/200))
print("Ceil of prices:",np.ceil(price/200))
print("Round of prices:",np.round(price/200))
print("Standard deviation of prices:",np.std(price))